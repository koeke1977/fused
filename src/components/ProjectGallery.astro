---
import type { WebsiteProject } from "../lib/sanity";

interface Props {
  project: WebsiteProject;
}

const { project } = Astro.props;
const images = [
  { image: project.image, alt: project.imageAlt },
  ...(project.gallery ?? []),
];
const layout = images.length === 1 ? "single" : images.length <= 3 ? "compact" : "extended";
---

<section class={`project-gallery project-gallery--${layout}`} aria-label="Projectfoto's">
  {images.map((item, index) => (
    <figure class="project-gallery__item">
      <img
        src={item.image}
        alt={item.alt}
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
      />
    </figure>
  ))}
</section>
