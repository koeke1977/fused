---
import type { WebsiteProject } from "../lib/sanity";

interface Props {
  project: WebsiteProject;
}

const { project } = Astro.props;
---
<article class="project-card">
  <a href={`/projecten/${project.slug}/`}>
    <img src={project.image} alt={project.imageAlt} loading="lazy" />
  </a>
  <div class="project-copy">
    <span class="eyebrow">{project.category}</span>
    <h3><a href={`/projecten/${project.slug}/`}>{project.title}</a></h3>
    <p>{project.summary}</p>
    <a class="text-link" href={`/projecten/${project.slug}/`}>Bekijk project ↗</a>
  </div>
</article>