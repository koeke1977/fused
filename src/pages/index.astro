---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { services } from "../data/services";
import { projects } from "../data/projects";
import { site } from "../data/site";
---
<BaseLayout title="Elektriciteitswerken voor jouw woning"><SiteHeader /><section class="hero"><div class="container hero-grid"><div><p class="eyebrow">FUSED · SWITCH ON QUALITY</p><h1>Techniek die werkt.<br /><span>Tot in de details.</span></h1><p>Elektriciteitswerken, domotica en verlichting voor wie kwaliteit belangrijk vindt.</p><a class="button" href="/projecten/">Ontdek onze realisaties</a></div><div class="hero-logo"><img src="/images/fused-logo-light.webp" alt="Fused – Switch on Quality" /></div></div></section><section class="section"><div class="container"><p class="eyebrow">WAAR FUSED VOOR STAAT</p><h2>Een sterke installatie begint bij <span>goed vakwerk.</span></h2><p>Van de eerste kabel tot de laatste afwerking: Fused denkt mee over elektrische oplossingen die passen bij jouw woning en jouw plannen.</p></div></section><section class="section services-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">WAT WE DOEN</p><h2>Onze expertise</h2></div></div><div class="services-grid">{services.map((service)=><ServiceCard service={service} />)}</div></div></section><section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">GEREALISEERD MET AANDACHT</p><h2>Projecten in de kijker</h2></div><a class="text-link" href="/projecten/">Alle projecten ↗</a></div><div class="projects-grid">{projects.map((project)=><ProjectCard project={project} />)}</div></div></section><section class="contact-band"><div class="container"><p class="eyebrow">EEN NIEUW PROJECT?</p><h2>Laat ons meedenken.</h2><a class="button" href={`mailto:${site.email}`}>Neem contact op ↗</a></div></section><SiteFooter /></BaseLayout>
