---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getProjects, getServices, getWebsiteSettings } from "../lib/sanity";

const [projects, services, settings] = await Promise.all([
  getProjects(),
  getServices(),
  getWebsiteSettings()
]);
const featuredProjects = projects.filter((project) => project.featured);
---
<BaseLayout title="Fused | Switch on Quality">
  <SiteHeader />
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{settings.heroEyebrow}</p>
          <h1>{settings.heroTitle}<br /><span>{settings.heroTitleAccent}</span></h1>
          <p>{settings.heroIntro}</p>
          <div class="hero-actions">
            <a class="button" href="/contact/">{settings.heroPrimaryCta} <span aria-hidden="true">↗</span></a>
            <a class="button button-ghost" href="/projecten/">{settings.heroSecondaryCta}</a>
          </div>
        </div>
        <div class="hero-brand">
          <img src="/images/FusedBlack.png" alt="Fused – Switch on Quality" />
          <span>ELEKTRICITEIT · DOMOTICA · VERLICHTING</span>
        </div>
      </div>
    </section>

    <section class="services-section section">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">{settings.servicesEyebrow}</p><h2>{settings.servicesTitle} <span>{settings.servicesTitleAccent}</span></h2></div>
          <p class="section-intro">{settings.servicesIntro}</p>
        </div>
        <div class="services-grid">{services.map((service) => <ServiceCard service={service} />)}</div>
      </div>
    </section>

    <section class="projects-section section">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">{settings.projectsEyebrow}</p><h2>{settings.projectsTitle}</h2></div>
          <a class="text-link" href="/projecten/">Alle projecten <span aria-hidden="true">↗</span></a>
        </div>
        <div class="projects-grid">{featuredProjects.map((project) => <ProjectCard project={project} />)}</div>
      </div>
    </section>

    <section class="contact-band">
      <div class="container contact-inner">
        <div><p class="eyebrow">{settings.contactEyebrow}</p><h2>{settings.contactTitle}</h2></div>
        <a class="button button-dark" href="/contact/">{settings.contactCta} <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
