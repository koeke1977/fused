---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { services } from "../data/services";
import { projects } from "../data/projects";
import { site } from "../data/site";
---
<BaseLayout title="Fused | Switch on Quality">
  <SiteHeader />
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">SWITCH ON QUALITY</p>
          <h1>Powerful techniek.<br /><span>Perfect afgewerkt.</span></h1>
          <p>Elektriciteit, slimme technologie en verlichting. Fused brengt alles samen in één doordachte installatie.</p>
          <div class="hero-actions">
            <a class="button" href="/contact/">Bespreek je project <span aria-hidden="true">↗</span></a>
            <a class="button button-ghost" href="/projecten/">Bekijk realisaties</a>
          </div>
        </div>
        <div class="hero-brand">
          <img src="/images/fused-logo-dark.webp" alt="Fused – Switch on Quality" />
          <span>ELEKTRICITEIT · DOMOTICA · VERLICHTING</span>
        </div>
      </div>
      <div class="hero-bottom container"><span>01 / 04</span><span>Techniek waarop je kan vertrouwen</span><span>BE · FUSED</span></div>
    </section>

    <section class="services-section section">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">WAT WE DOEN</p><h2>Alles begint met <span>de juiste connectie.</span></h2></div>
          <p class="section-intro">Van een betrouwbare elektrische basis tot slimme oplossingen die je dagelijks leven makkelijker maken.</p>
        </div>
        <div class="services-grid">{services.map((service) => <ServiceCard service={service} />)}</div>
      </div>
    </section>

    <section class="projects-section section">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">ONS WERK</p><h2>Gerealiseerd door Fused.</h2></div>
          <a class="text-link" href="/projecten/">Alle projecten <span aria-hidden="true">↗</span></a>
        </div>
        <div class="projects-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
      </div>
    </section>

    <section class="contact-band">
      <div class="container contact-inner">
        <div><p class="eyebrow">KLAAR OM TE STARTEN?</p><h2>Jouw plannen.<br />Onze expertise.</h2></div>
        <a class="button button-dark" href={`mailto:${site.email}`}>Vertel ons erover <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
