---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { services } from "../../data/services";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
---
<BaseLayout title={service.title}>
  <SiteHeader />
  <main>
    <section class="page-hero service-detail">
      <div class="container">
        <p class="eyebrow">ONZE DIENSTEN</p>
        <h1>{service.title}</h1>
        <p>{service.summary}</p>
        {"details" in service && (
          <div class="service-detail-extra">
            <h2>{service.detailsTitle}</h2>
            <ul>
              {service.details.map((detail) => <li>{detail}</li>)}
            </ul>
            <p class="service-detail-note">De officiële keuring wordt uitgevoerd door een erkend controleorganisme.</p>
          </div>
        )}
        <a class="button" href="/contact/">Bespreek je project</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
