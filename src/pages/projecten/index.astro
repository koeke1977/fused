import { projects } from "../../data/projects";
---
<BaseLayout title="Projecten"><SiteHeader /><section class="page-hero"><div class="container"><p class="eyebrow">ONZE REALISATIES</p><h1>Gemaakt met oog<br /><span>voor kwaliteit.</span></h1><p>Een selectie van elektrische installaties en slimme oplossingen.</p></div></section><section class="section"><div class="container projects-grid">{projects.map((project)=><ProjectCard project={project} />)}</div></section><SiteFooter /></BaseLayout>
