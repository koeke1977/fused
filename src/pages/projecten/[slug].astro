---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getProjects } from "../../lib/sanity";

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---
<BaseLayout title={project.title} description={project.summary}>
  <SiteHeader />
  <main>
    <article>
      <header class="project-detail-copy container">
        <p class="eyebrow">{project.category}</p>
        <h1>{project.title}</h1>
        {project.year && <p class="project-year">Uitgevoerd in {project.year}</p>}
        <p>{project.summary}</p>
      </header>
      <div class="container project-detail-image">
        <img src={project.image} alt={project.imageAlt} />
      </div>
      {project.description && (
        <div class="project-detail-copy container">
          <p>{project.description}</p>
        </div>
      )}
      {project.gallery && project.gallery.length > 0 && (
        <section class="container project-gallery" aria-label="Extra projectfoto's">
          {project.gallery.map((item) => (
            <img src={item.image} alt={item.alt} loading="lazy" />
          ))}
        </section>
      )}
      <div class="project-detail-copy container">
        <a class="text-link" href="/projecten/">← Terug naar projecten</a>
      </div>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>