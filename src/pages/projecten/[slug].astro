---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { projects } from "../../data/projects";
export function getStaticPaths(){return projects.map((project)=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props;
---
<BaseLayout title={project.title} description={project.summary}><SiteHeader /><article><header class="project-detail-copy container"><p class="eyebrow">{project.category}</p><h1>{project.title}</h1><p>{project.summary}</p></header><div class="container project-detail-image"><img src={project.image} alt={project.imageAlt} /></div><div class="project-detail-copy container"><p>{project.description}</p><a class="text-link" href="/projecten/">← Terug naar projecten</a></div></article><SiteFooter /></BaseLayout>
