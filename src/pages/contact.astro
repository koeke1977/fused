---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
---
<BaseLayout title="Contact"><SiteHeader /><section class="page-hero"><div class="container"><p class="eyebrow">CONTACT</p><h1>Vertel ons over<br /><span>jouw plannen.</span></h1><p>Een vraag of een idee voor een nieuw project? Fused denkt graag met je mee.</p><p><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></p></div></section><SiteFooter /></BaseLayout>
