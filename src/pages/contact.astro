---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
---
<BaseLayout title="Contact | Fused">
  <SiteHeader />
  <main>
    <section class="page-hero contact-page">
      <div class="container">
        <p class="eyebrow">CONTACT</p>
        <h1>Vertel ons over<br /><span>jouw plannen.</span></h1>
        <p>Een vraag of een idee voor een nieuw project? Vertel ons waar je aan denkt. We bekijken graag samen wat Fused voor je kan betekenen.</p>
      </div>
    </section>
    <section class="contact-form-section">
      <div class="container contact-form-layout">
        <div class="contact-form-intro">
          <p class="eyebrow">STEL JE VRAAG</p>
          <h2>Waarmee kunnen<br /><span>we je helpen?</span></h2>
          <p>Bezorg ons wat meer informatie. Zodra de beveiligde mailkoppeling actief is, ontvang je na verzending ook automatisch een kopie van je bericht.</p>
          <div class="contact-direct">
            <span>Toch liever telefonisch?</span>
            <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
          </div>
        </div>
        <form class="contact-form" aria-describedby="contact-form-notice">
          <div class="form-field">
            <label for="contact-name">Naam <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Je volledige naam" required disabled />
          </div>
          <div class="form-field">
            <label for="contact-email">E-mailadres <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="naam@voorbeeld.be" required disabled />
          </div>
          <div class="form-field">
            <label for="contact-phone">Telefoonnummer <span class="optional">(optioneel)</span></label>
            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" placeholder="+32 ..." disabled />
          </div>
          <div class="form-field">
            <label for="contact-subject">Waarover gaat je vraag? <span aria-hidden="true">*</span></label>
            <select id="contact-subject" name="subject" required disabled>
              <option value="">Kies een onderwerp</option>
              <option value="Elektriciteitswerken">Elektriciteitswerken</option>
              <option value="Domotica en smart home">Domotica / Smart Home</option>
              <option value="Verlichting">Verlichting</option>
              <option value="Industriële installaties">Industriële installaties</option>
              <option value="Andere vraag">Andere vraag</option>
            </select>
          </div>
          <div class="form-field form-field-wide">
            <label for="contact-message">Je bericht <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" rows="6" placeholder="Vertel ons kort wat je plannen zijn..." required disabled></textarea>
          </div>
          <p class="form-privacy">We gebruiken je gegevens uitsluitend om je vraag te beantwoorden. De definitieve privacy-informatie wordt toegevoegd bij activatie van het formulier.</p>
          <button class="button contact-submit" type="button" disabled>Verzending binnenkort beschikbaar</button>
          <p class="form-notice" id="contact-form-notice" role="status">Het contactformulier wordt momenteel klaargemaakt. Berichten kunnen nog niet worden verzonden.</p>
        </form>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
