---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getWebsiteSettings } from "../lib/sanity";

const settings = await getWebsiteSettings();
---
<BaseLayout title="Contact | Fused">
  <SiteHeader />
  <main>
    <section class="page-hero contact-page">
      <div class="container">
        <p class="eyebrow">CONTACT</p>
        <h1>Vertel ons over<br /><span>jouw plannen.</span></h1>
        <p>Een vraag of een idee voor een nieuw project? Vertel ons waar je aan denkt. We bekijken graag samen wat Fused voor je kan betekenen.</p>
      </div>
    </section>
    <section class="contact-form-section">
      <div class="container contact-form-layout">
        <div class="contact-form-intro">
          <p class="eyebrow">STEL JE VRAAG</p>
          <h2>Waarmee kunnen<br /><span>we je helpen?</span></h2>
          <p>Bezorg ons wat meer informatie. Je kunt ook foto's of documenten toevoegen, zodat we meteen een beter beeld krijgen van je vraag.</p>
          <div class="contact-direct">
            <span>Toch liever telefonisch?</span>
            <a href={`tel:${settings.phoneHref}`}>{settings.phoneDisplay}</a>
          </div>
        </div>
        <form class="contact-form" aria-describedby="contact-form-notice" novalidate>
          <div class="form-field">
            <label for="contact-name">Naam <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Je volledige naam" required />
          </div>
          <div class="form-field">
            <label for="contact-email">E-mailadres <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="naam@voorbeeld.be" required />
          </div>
          <div class="form-field">
            <label for="contact-phone">Telefoonnummer <span class="optional">(optioneel)</span></label>
            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" placeholder="+32 ..." />
          </div>
          <div class="form-field">
            <label for="contact-subject">Waarover gaat je vraag? <span aria-hidden="true">*</span></label>
            <select id="contact-subject" name="subject" required>
              <option value="">Kies een onderwerp</option>
              <option value="Elektriciteitswerken">Elektriciteitswerken</option>
              <option value="Domotica en smart home">Domotica / Smart Home</option>
              <option value="Verlichting">Verlichting</option>
              <option value="Industriële installaties">Industriële installaties</option>
              <option value="Andere vraag">Andere vraag</option>
            </select>
          </div>
          <div class="form-field form-field-wide">
            <label for="contact-message">Je bericht <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" rows="6" placeholder="Vertel ons kort wat je plannen zijn..." required></textarea>
          </div>
          <div class="form-field form-field-wide">
            <label for="contact-files">Foto's of documenten <span class="optional">(optioneel)</span></label>
            <div class="file-upload" data-file-upload>
              <input class="file-upload-input" id="contact-files" name="attachments" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" multiple />
              <label class="file-upload-dropzone" for="contact-files">
                <span class="file-upload-icon" aria-hidden="true">＋</span>
                <strong>Voeg bestanden toe</strong>
                <span>Sleep ze hierheen of klik om te kiezen</span>
                <small>JPG, PNG, WEBP of PDF · Maximaal 5 bestanden · 10 MB per bestand</small>
              </label>
              <ul class="file-upload-list" data-file-list aria-live="polite"></ul>
              <p class="file-upload-error" data-file-error role="alert" hidden></p>
            </div>
          </div>
          <p class="form-privacy">Je gegevens en bijlagen worden uitsluitend gebruikt om je aanvraag te behandelen. De definitieve privacy-informatie en beveiligde verzending worden voorzien bij de activatie van het formulier.</p>
          <button class="button contact-submit" type="button" disabled>Verzenden binnenkort beschikbaar</button>
          <p class="form-notice" id="contact-form-notice" role="status">Je kunt het formulier en de bijlagen al invullen en klaarzetten. Verzenden wordt geactiveerd zodra de beveiligde koppeling beschikbaar is.</p>
        </form>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<script src="../scripts/contact-form.ts"></script>
